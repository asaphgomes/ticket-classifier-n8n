      "parameters": {
        "jsCode": "const tickets = $input.all();\nconst total = tickets.length;\n\n// Contagem por categoria\nconst porCategoria = {};\nconst porPrioridade = {};\nconst porSentimento = {};\nlet criticos = 0;\n\nfor (const t of tickets) {\n  const f = t.json.fields;\n  \n  porCategoria[f.Categoria] = (porCategoria[f.Categoria] || 0) + 1;\n  porPrioridade[f.Prioridade] = (porPrioridade[f.Prioridade] || 0) + 1;\n  porSentimento[f.Sentimento] = (porSentimento[f.Sentimento] || 0) + 1;\n  \n  if (f.Prioridade === 'Critica') criticos++;\n}\n\n// Monta linhas HTML por categoria\nconst linhasCategoria = Object.entries(porCategoria)\n  .map(([cat, qtd]) => `\n    <tr>\n      <td style=\"padding:8px;border-bottom:1px solid #eee\">${cat}</td>\n      <td style=\"padding:8px;border-bottom:1px solid #eee;text-align:center\">${qtd}</td>\n      <td style=\"padding:8px;border-bottom:1px solid #eee;text-align:center\">\n        ${Math.round((qtd/total)*100)}%\n      </td>\n    </tr>`\n  ).join('');\n\nconst linhasPrioridade = Object.entries(porPrioridade)\n  .map(([pri, qtd]) => `\n    <tr>\n      <td style=\"padding:8px;border-bottom:1px solid #eee\">${pri}</td>\n      <td style=\"padding:8px;border-bottom:1px solid #eee;text-align:center\">${qtd}</td>\n    </tr>`\n  ).join('');\n\n// Data da semana\nconst hoje = new Date();\nconst seteDias = new Date(hoje - 7*24*60*60*1000);\nconst periodo = `${seteDias.toLocaleDateString('pt-BR')} a ${hoje.toLocaleDateString('pt-BR')}`;\n\nreturn [{\n  json: {\n    total,\n    criticos,\n    porCategoria,\n    porPrioridade,\n    porSentimento,\n    linhasCategoria,\n    linhasPrioridade,\n    periodo\n  }\n}];"
      },
