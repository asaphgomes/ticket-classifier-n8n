    {
      "parameters": {
        "jsCode": "const descricao = $input.first().json[\"Descrição do Problema\"];\nconst nome = $input.first().json[\"Nome\"];\nconst email = $input.first().json[\"Email\"];\nconst chave = \"YOUR_GROQ_API_KEY\";\nconst https = require('https');\n\nconst timestamp = Date.now();\nconst numeroTicket = \"TKT-\" + timestamp.toString().slice(-6);\n\ntry {\n  const bodyStr = JSON.stringify({\n    model: \"llama-3.3-70b-versatile\",\n    messages: [\n      { role: \"system\", content: \"Classifique o ticket e retorne APENAS JSON neste formato exato: {\\\"categoria\\\": \\\"Bug\\\", \\\"prioridade\\\": \\\"Alta\\\", \\\"sentimento\\\": \\\"Frustrado\\\", \\\"resumo\\\": \\\"frase curta\\\"}. Categorias: Bug, Duvida, Financeiro, Acesso, Outro. Prioridades: Baixa, Media, Alta, Critica. Sentimentos: Neutro, Frustrado, Satisfeito, Urgente.\" },\n      { role: \"user\", content: descricao }\n    ]\n  });\n\n  const data = await new Promise((resolve, reject) => {\n    const options = {\n      hostname: \"api.groq.com\",\n      path: \"/openai/v1/chat/completions\",\n      method: \"POST\",\n      headers: {\n        \"Content-Type\": \"application/json\",\n        \"Authorization\": \"Bearer \" + chave,\n        \"Content-Length\": Buffer.byteLength(bodyStr)\n      }\n    };\n    const req = https.request(options, (res) => {\n      let raw = \"\";\n      res.on(\"data\", (chunk) => { raw += chunk; });\n      res.on(\"end\", () => { resolve(JSON.parse(raw)); });\n    });\n    req.on(\"error\", reject);\n    req.write(bodyStr);\n    req.end();\n  });\n\n  const classificacao = JSON.parse(data.choices[0].message.content);\n\n  return [{ json: {\n    Nome: nome,\n    Email: email,\n    Ticket: numeroTicket,\n    Categoria: classificacao.categoria,\n    Prioridade: classificacao.prioridade,\n    Sentimento: classificacao.sentimento,\n    Resumo: classificacao.resumo,\n    Data: new Date().toISOString().split('T')[0]\n  }}];\n\n} catch (erro) {\n  return [{ json: {\n    Nome: nome,\n    Email: email,\n    Ticket: numeroTicket,\n    Categoria: \"Não classificado\",\n    Prioridade: \"Média\",\n    Sentimento: \"Neutro\",\n    Resumo: \"Erro na classificação automática — revisar manualmente\",\n    Data: new Date().toISOString().split('T')[0],\n    Erro: erro.message\n  }}];\n}"
      },
